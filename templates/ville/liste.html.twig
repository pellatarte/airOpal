{% extends 'base.html.twig' %}

{% block title %}Les villes — AirOpale{% endblock %}

{% block body %}
    <h1>Les villes</h1>

    <table>
        <tr>
            <th>Ville</th>
            <th>Latitude</th>
            <th>Longitude</th>
        </tr>
        {% for ville in villes %}
            <tr>
                <td>{{ ville.nom }}</td>
                <td>{{ ville.latitude }}</td>
                <td>{{ ville.longitude }}</td>
            </tr>
        {% endfor %}
    </table>

    <p>{{ villes|length }} villes.</p>
{% endblock %}
