<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}AirOpale{% endblock %}</title>
        <link rel="stylesheet" href="/css/style.css">
    </head>
    <body>
        <header>
            <a class="logo" href="{{ path('accueil') }}">AirOpale</a>
            <nav>
                {% block menu %}
                    <a href="{{ path('accueil') }}">Accueil</a>
                    <a href="{{ path('ville_liste') }}">Villes</a>
                {% endblock %}
            </nav>
        </header>

        <main>
            <h1>
                {% block body %}
                    {{ ville.nom }}
                {% endblock %}
            </h1>
            <p class="discret">
                {{ ville.latitude }}
                {{ ville.longitude }}
            </p>
        </main>

        <footer>
            Données : <a href="https://open-meteo.com/">Open-Meteo.com</a> (CC BY 4.0)
            · R3.01 — IUT du Littoral Côte d'Opale
        </footer>
    </body>
</html>
